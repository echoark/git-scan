{
  "type": "object",
  "required": ["status", "findings", "acknowledged", "commits_reviewed", "summary"],
  "properties": {
    "status": {"type": "string", "enum": ["completed", "failed"]},
    "failure_reason": {"type": ["string", "null"]},
    "review_mode": {"type": "string", "enum": ["public", "relaxed"]},
    "commits_reviewed": {"type": "array", "items": {"type": "string"}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "value", "location", "note"],
        "properties": {
          "category": {"type": "string"},
          "value": {"type": "string"},
          "location": {"type": "string"},
          "note": {"type": "string"},
          "entry": {"type": ["string", "null"]}
        }
      }
    },
    "acknowledged": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entry", "location", "value", "ack"],
        "properties": {
          "entry": {"type": "string"},
          "location": {"type": "string"},
          "value": {"type": "string"},
          "ack": {"type": "string"}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "summary": {"type": "string"}
  }
}
